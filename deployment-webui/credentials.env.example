# Proxmox Credentials for LXC Deployment
# Copy this file to credentials.env and fill in your values
# Then source it before running deploy-lxc.sh:
#   source credentials.env && ./deploy-lxc.sh

# Proxmox API Token
# Format: user@pam!tokenid=secret
# Create at: Datacenter -> Permissions -> API Tokens
export PROXMOX_API_TOKEN="root@pam!deployment=your-token-secret-here"

# Proxmox SSH Password (for root user)
export PROXMOX_SSH_PASSWORD="your-proxmox-root-password"

# LXC Container Root Password
export LXC_ROOT_PASSWORD="your-container-root-password"
