# Keycloak Admin Credentials
# TEMPLATE — encrypt with SOPS before committing:
#   sops -e --age age1hdskklcj78alg00z80u6r5cgm9w5fcg33y0n064kss33ugmqca5q9zcerp \
#     keycloak-credentials.sops.yaml.template > keycloak-credentials.sops.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-credentials
  namespace: keycloak
  labels:
    app.kubernetes.io/name: keycloak
    app.kubernetes.io/component: identity
    app.kubernetes.io/managed-by: sops
type: Opaque
stringData:
  # Keycloak admin password — change before encrypting
  admin-password: "CHANGE_ME_BEFORE_ENCRYPTING"
---
# Also need the DB credentials in the keycloak namespace
# (must match the password in cleanroom-db/keycloak-db-credentials)
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-db-credentials
  namespace: keycloak
  labels:
    app.kubernetes.io/name: keycloak
    app.kubernetes.io/component: identity
    app.kubernetes.io/managed-by: sops
type: Opaque
stringData:
  postgres-password: "CHANGE_ME_MUST_MATCH_CLEANROOM_DB_SECRET"
