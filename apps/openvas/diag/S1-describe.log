  gvmd:
    Container ID:  containerd://2677eb65f5bf5b10dabe3453d90474cf5f51e6504551c8a078a4013c42fe33d1
    Image:         harbor.knowledgeondemand.net/cleanroom/gvmd:stable
    Image ID:      harbor.knowledgeondemand.net/cleanroom/gvmd@sha256:d8e104822070df12d9d12a4ac7e1be3fe53090a756a03f23d3ebeb3c5d0ecdb2
    Port:          <none>
    Host Port:     <none>
    Command:
      /bin/sh
      -c
    Args:
      echo "Waiting for PostgreSQL socket..."
      while [ ! -S /var/run/postgresql/.s.PGSQL.5432 ]; do sleep 2; done
      echo "PostgreSQL ready. Waiting for OSPD socket..."
      while [ ! -S /run/ospd/ospd-openvas.sock ]; do sleep 2; done
      echo "OSPD ready."
      
      # Create admin user if it doesn't exist (first run only)
      # Run as gvmd user via gosu to connect to PostgreSQL properly
      # Password is injected via GVMD_ADMIN_PASSWORD environment variable
      if ! gosu gvmd gvmd --get-users 2>/dev/null | grep -q "^admin$"; then
        echo "Creating admin user..."
        gosu gvmd gvmd --create-user=admin --password="${GVMD_ADMIN_PASSWORD}" || echo "User creation failed or already exists"
      else
        echo "Admin user already exists."
      fi
      
      # Set Feed Import Owner to admin user (required for feed synchronization)
      # The setting UUID 78eceaec-3385-11ea-b237-28d24461215b is the Feed Import Owner setting
      echo "Setting Feed Import Owner..."
      ADMIN_UUID=$(gosu gvmd gvmd --get-users --verbose 2>/dev/null | grep "^admin " | awk '{print $2}')
      if [ -n "$ADMIN_UUID" ]; then
        gosu gvmd gvmd --modify-setting 78eceaec-3385-11ea-b237-28d24461215b --value "$ADMIN_UUID" 2>/dev/null || echo "Feed owner setting may already be configured"
        echo "Feed Import Owner set to admin ($ADMIN_UUID)"
      else
        echo "Warning: Could not determine admin UUID for Feed Import Owner"
      fi
      
      # Generate GVM TLS certificates if missing (required by GSA v25+)
      if ! gvm-manage-certs -V >/dev/null 2>&1; then
        echo "Generating GVM TLS certificates..."
        gvm-manage-certs -a
        echo "GVM certificates generated."
      else
        echo "GVM certificates OK."
      fi
      
      echo "Starting GVMD..."
      # GSA v25+ communicates with gvmd via TLS on the Unix socket.
      # gvmd automatically uses TLS when certs exist in /var/lib/gvm/CA/.
      exec /usr/local/bin/entrypoint gvmd -f
      
    State:          Running
      Started:      Fri, 10 Apr 2026 08:16:09 -0500
