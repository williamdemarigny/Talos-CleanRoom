  psql-data-setup:
    Container ID:  containerd://78339c1e3b9cf57683b3416a7ab6d4320b3915212b8b299293d3c82cc7954c02
    Image:         harbor.knowledgeondemand.net/cleanroom/pg-gvm:stable
    Image ID:      harbor.knowledgeondemand.net/cleanroom/pg-gvm@sha256:b07b2c458734c285f8b4ad65ff852335a53d4cdb61c8a4f41ff4da136d75762a
    Port:          <none>
    Host Port:     <none>
    Command:
      /bin/bash
      -c
    Args:
      set -e
      echo "Setting up PostgreSQL data directory..."
      
      # Set ownership first
      chown -R postgres:postgres /var/lib/postgresql
      chmod 700 /var/lib/postgresql
      
      # Check if cluster already initialized
      if [ -f /var/lib/postgresql/17/main/PG_VERSION ]; then
        echo "PostgreSQL cluster already exists."
        exit 0
      fi
      
      echo "Initializing PostgreSQL 17 cluster..."
      mkdir -p /var/lib/postgresql/17/main
      chown -R postgres:postgres /var/lib/postgresql/17
      chmod 700 /var/lib/postgresql/17/main
      
      # Run initdb as postgres user
      su postgres -c "/usr/lib/postgresql/17/bin/initdb -D /var/lib/postgresql/17/main"
      
      echo "PostgreSQL data directory ready."
      
    State:          Terminated
