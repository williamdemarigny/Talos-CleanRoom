# Talos CleanRoom Deployment Web UI Configuration
# Copy this file to .env and update the values

# Authentication
# Default username for the admin user
ADMIN_USERNAME=admin

# Password hash for admin user (default: admin)
# Generate new hash: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/X4xL4FXvQsZI5EjBi

# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-in-production

# Token expiration time in hours
ACCESS_TOKEN_EXPIRE_HOURS=8

# Deployment Settings
# Master node FQDN for health checks
MASTER_NODE=talos-CleanRoom-master-01.knowledgeondemand.net

# Number of health check retries
HEALTH_CHECK_RETRIES=30

# Seconds between health check retries
HEALTH_CHECK_INTERVAL=10
