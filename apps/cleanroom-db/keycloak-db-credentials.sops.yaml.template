# Keycloak Database Credentials
# TEMPLATE — encrypt with SOPS before committing:
#   sops -e --age age1hdskklcj78alg00z80u6r5cgm9w5fcg33y0n064kss33ugmqca5q9zcerp \
#     keycloak-db-credentials.sops.yaml.template > keycloak-db-credentials.sops.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-db-credentials
  namespace: cleanroom-db
  labels:
    app.kubernetes.io/name: cleanroom-db
    app.kubernetes.io/component: database
    app.kubernetes.io/managed-by: sops
type: Opaque
stringData:
  # Non-superuser password for Keycloak database access
  # Generate with: openssl rand -base64 32
  postgres-password: "CHANGE_ME_BEFORE_ENCRYPTING"
