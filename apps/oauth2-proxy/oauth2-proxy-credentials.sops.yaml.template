# OAuth2-Proxy Credentials
# TEMPLATE — encrypt with SOPS before committing:
#   sops -e --age age1hdskklcj78alg00z80u6r5cgm9w5fcg33y0n064kss33ugmqca5q9zcerp \
#     oauth2-proxy-credentials.sops.yaml.template > oauth2-proxy-credentials.sops.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: oauth2-proxy-credentials
  namespace: oauth2-proxy
  labels:
    app.kubernetes.io/name: oauth2-proxy
    app.kubernetes.io/component: identity
    app.kubernetes.io/managed-by: sops
type: Opaque
stringData:
  # Must match the client secret configured in Keycloak for "traefik-forward-auth" client
  client-secret: "CHANGE_ME_BEFORE_ENCRYPTING"
  # Generate with: openssl rand -base64 32 | head -c 32
  cookie-secret: "CHANGE_ME_BEFORE_ENCRYPTING"
