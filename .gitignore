# Terraform state & plans
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfplan*

# Terraform credentials / env (sensitive)
credentials.auto.tfvars
*.auto.tfvars.json
credentials.sh
.envrc

# OPNSense generated scripts and backups (contain sensitive API credentials)
**/scripts/opnsense_*.ps1
**/opnsense_backups/*.xml
**/opnsense_backups/*.tar.gz

# Unencrypted secrets (must be encrypted with SOPS before committing)
# Keep the .sops.yaml versions, ignore plaintext
**/repo-credentials.yaml
!**/repo-credentials.sops.yaml
